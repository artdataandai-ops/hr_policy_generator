# Copy to .env and fill in after creating the agents in Lyzr Studio.
# NEVER commit .env — it is gitignored on purpose. The Lyzr key stays server-side,
# never shipped to the browser. Without LYZR_API_KEY + LYZR_MANAGER_AGENT_ID the
# /api/chat endpoint returns 503 (the agents ARE the intelligence — no local fallback).

# Required: your Lyzr API key.
LYZR_API_KEY=

# Lyzr v3 inference endpoint (default is correct for most setups).
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# Lyzr user id used for all calls.
LYZR_USER_ID=hr-policy@arttechgroup.demo

# ── Agent ids, one block per slug in agents.json ──────────────────────────────
# All agents share the single LYZR_API_KEY above; only the agent ids differ.
# Adding an agent = add its block to agents.json + its ids here, then restart.

# slug "hr-policy" — Manager Agent (default chat target; orchestrates 3 sub-agents).
LYZR_MANAGER_AGENT_ID=
# Its sub-agents (ids feed the allowlist + the trace).
LYZR_REQUIREMENTS_AGENT_ID=   # Policy Requirements Agent
LYZR_COMPLIANCE_AGENT_ID=     # Compliance & Guidelines Agent (Perplexity-powered search)
LYZR_DRAFTING_AGENT_ID=       # Policy Drafting Agent

# Add a block here for each additional Lyzr agent (one manager id var per slug,
# plus any sub-agent id vars). Keep the var names in sync with agents.json.

# slug "support-sentiment" — Customer Support Sentiment & Insight Analyzer (no sub-agents).
SUPPORT_SENTIMENT_AGENT_ID=

# slug "hr-hiring" — AI HR Hiring Manager (manager + 3 sub-agents).
HR_HIRING_MANAGER_AGENT_ID=
JOB_DESCRIPTION_AGENT_ID=
EVALUATION_CRITERIA_AGENT_ID=
RESUME_EVALUATION_AGENT_ID=

# slug "sales-enablement" — Sales Enablement Content Generator (manager + 4 sub-agents).
SALES_ENABLEMENT_MANAGER_AGENT_ID=
SALES_CONTENT_QUALITY_AGENT_ID=
SALES_CONTENT_GENERATION_AGENT_ID=
SALES_MESSAGING_FRAMEWORK_AGENT_ID=
SALES_AUDIENCE_PERSONA_AGENT_ID=

# slug "rfp-proposal" — RFP & Proposal Response Automation (orchestrator + 5 sub-agents).
RFP_ORCHESTRATOR_AGENT_ID=
RFP_RESPONSE_QUALITY_AGENT_ID=
RFP_COMPLIANCE_RISK_AGENT_ID=
RFP_COMMERCIAL_VALUE_AGENT_ID=
RFP_TECHNICAL_RESPONSE_AGENT_ID=
RFP_PARSING_STRUCTURE_AGENT_ID=

# slug "it-helpdesk" — IT Helpdesk Agent (orchestrator + 4 sub-agents).
IT_HELPDESK_ORCHESTRATOR_AGENT_ID=
IT_ACCESS_REQUEST_AGENT_ID=
IT_TICKET_GENERATOR_AGENT_ID=
IT_TROUBLESHOOTING_AGENT_ID=
IT_KB_AGENT_ID=

# Comma-separated allowlist of agent ids the proxy may forward to (kyc-kyb pattern).
# Leave blank to auto-allow each slug's own ids. Set to add globally-allowed ids on top.
LYZR_ALLOWED_AGENTS=

# CORS — allowed frontend origin(s), comma-separated (localhost dev hosts always allowed).
# Set this to the deployed frontend origin, e.g. https://hr-policy.arttechgroup.pages.dev
CORS_ALLOWED_ORIGINS=
