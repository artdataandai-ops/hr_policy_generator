# Scope guard — blocks clearly off-topic messages before the real agent runs, using
# Groq llama-3.1-8b-instant called directly. Per-agent scope + refusal text live in
# backend/guardrails.json. Leave GROQ_API_KEY blank to disable the guard (fails open).
GROQ_API_KEY=
# Optional overrides:
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# Comma-separated allowlist of agent ids the proxy may forward to (kyc-kyb pattern).
# Leave blank to auto-allow each slug's own ids. Set to add globally-allowed ids on top.
LYZR_ALLOWED_AGENTS=

# CORS — allowed frontend origin(s), comma-separated (localhost dev hosts always allowed).
# Set this to the deployed frontend origin, e.g. https://hr-policy.arttechgroup.pages.dev
CORS_ALLOWED_ORIGINS=
